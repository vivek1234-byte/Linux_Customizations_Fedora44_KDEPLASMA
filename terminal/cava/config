# cava — sakura / Kimi no Na wa theme (shown on the desktop by cava-desktop)

[general]
framerate = 60
autosens = 1
sensitivity = 130
bars = 0
bar_width = 1
bar_spacing = 1
lower_cutoff_freq = 50
higher_cutoff_freq = 12000
sleep_timer = 0

[input]
method = pulse
source = auto

[output]
method = noncurses
channels = stereo
mono_option = average
reverse = 0

[color]
background = default
gradient = 1
gradient_count = 6
gradient_color_1 = '#FF8FC7'
gradient_color_2 = '#F7A8C4'
gradient_color_3 = '#D9B8FF'
gradient_color_4 = '#B5A8FF'
gradient_color_5 = '#8EC5FF'
gradient_color_6 = '#E8F2FF'

[smoothing]
monstercat = 1
waves = 0
noise_reduction = 77

[eq]
